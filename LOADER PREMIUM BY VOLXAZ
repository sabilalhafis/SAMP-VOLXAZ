-- =====================================
-- PEMBACA WIDGET
-- =====================================

local function widgetTekan(id)

    if type(id) ~= 'number' then
        return false
    end

    if type(isWidgetPressed)
        == 'function' then

        local ok, hasil = pcall(
            isWidgetPressed,
            id
        )

        if ok then
            return hasil == true
                or (
                    type(hasil) == 'number'
                    and hasil ~= 0
                )
        end

        return false
    end

    if type(isWidgetPressedEx)
        == 'function' then

        local ok, hasil = pcall(
            isWidgetPressedEx,
            id,
            0
        )

        if ok then
            return hasil == true
                or (
                    type(hasil) == 'number'
                    and hasil ~= 0
                )
        end
    end

    return false
end

-- =====================================
-- PEMBACA PAD
-- =====================================

local function padTekan(kunci)

    if type(getPadState)
        ~= 'function' then

        return false
    end

    local ok, nilai = pcall(
        getPadState,
        0,
        kunci
    )

    if not ok then
        return false
    end

    if type(nilai) == 'boolean' then
        return nilai
    end

    return type(nilai) == 'number'
        and nilai > 10
end

-- =====================================
-- DETEKSI GAS DAN REM LIVE
--
-- GAS DAN REM DIPANTAU TERPISAH.
-- TIDAK PERLU ON/OFF UNTUK BERGANTI.
-- =====================================

local function bacaInput()

    local wg, wr = false, false
    local pg, pr = false, false

    local hasil = {}

    -- Pembacaan melalui widget.
    if sumber ~= 3 then

        wg = widgetTekan(
            widget.WIDGET_ACCELERATE
        )

        wr = widgetTekan(
            widget.WIDGET_BRAKE
        )

        hasil[#hasil + 1] =
            'WIDGET G=' ..
            (wg and '1' or '0') ..
            ' R=' ..
            (wr and '1' or '0')
    end

    -- Pembacaan melalui tombol PAD.
    if sumber ~= 2 then

        pg = padTekan(16)
        pr = padTekan(14)

        hasil[#hasil + 1] =
            'PAD G=' ..
            (pg and '1' or '0') ..
            ' R=' ..
            (pr and '1' or '0')
    end

    -- Perbarui kedua status setiap siklus.
    gas = wg or pg
    remDitekan = wr or pr

    gasTeks = gas
        and 'DITEKAN'
        or 'LEPAS'

    remTeks = remDitekan
        and 'DITEKAN'
        or 'LEPAS'

    rincian = table.concat(
        hasil,
        ' | '
    )

    -- Catat gas saat baru ditekan.
    if gas and not gasDulu then

        jumlahGas = jumlahGas + 1
        pernahGas = true

        catat(
            'GAS TERDETEKSI ' ..
            jumlahGas ..
            'x | ' .. rincian
        )
    end

    -- Catat rem secara independen.
    if remDitekan and not remDulu then

        jumlahRem = jumlahRem + 1
        pernahRem = true

        catat(
            'REM TERDETEKSI ' ..
            jumlahRem ..
            'x | ' .. rincian
        )
    end

    gasDulu = gas
    remDulu = remDitekan
end

-- =====================================
-- MATIKAN BANTUAN
-- =====================================

local function matikan(teks)

    bantuan = false

    idAktif = nil
    modelAktif = nil

    if teks then
        info(teks)
    end
end

-- =====================================
-- RESET NORMAL
-- =====================================

local function reset()

    matikan(nil)

    batasKmh[0] = 180
    aksel[0] = 100
    rem[0] = 100
    jeda[0] = 350

    info(
        'RESET NORMAL. ' ..
        'BANTUAN DIMATIKAN.'
    )
end

-- =====================================
-- PROFIL HANDLING
-- =====================================

local function preset(tingkat)

    matikan(nil)

    if tingkat == 1 then

        -- SANTAI
        batasKmh[0] = 160
        aksel[0] = 130
        rem[0] = 120
        jeda[0] = 450

        info(
            'PROFIL SANTAI DIPILIH. ' ..
            'TEKAN TERAPKAN.'
        )

    elseif tingkat == 2 then

        -- KENCANG
        batasKmh[0] = 240
        aksel[0] = 230
        rem[0] = 190
        jeda[0] = 300

        info(
            'PROFIL KENCANG DIPILIH. ' ..
            'TEKAN TERAPKAN.'
        )

    else

        -- BRUTAL
        batasKmh[0] = 420
        aksel[0] = 650
        rem[0] = 450
        jeda[0] = 160

        info(
            'PROFIL BRUTAL DIPILIH. ' ..
            'TEKAN TERAPKAN.'
        )
    end
end

-- =====================================
-- TERAPKAN PENGATURAN
-- =====================================

local function terapkan()

    local data, masalah = kendaraan()

    if not data then
        info(masalah)
        return
    end

    if dikecualikan[data.model] then

        info(
            'JENIS KENDARAAN ' ..
            'BELUM DIDUKUNG'
        )

        return
    end

    if type(setCarForwardSpeed)
        ~= 'function' then

        info(
            'API PENGUBAH LAJU TIDAK ADA'
        )

        return
    end

    if not pantau then

        info(
            'AKTIFKAN PEMANTAUAN INPUT DULU'
        )

        return
    end

    -- Pastikan gas dan rem sudah
    -- berhasil terbaca bergantian.
    if not pernahGas or not pernahRem then

        info(
            'UJI GAS DAN REM ' ..
            'BERGANTIAN DULU'
        )

        return
    end

    -- Kedua slider normal:
    -- tidak ada perubahan kecepatan.
    if aksel[0] <= 100
        and rem[0] <= 100 then

        matikan(
            '100% NORMAL. ' ..
            'TIDAK ADA PERUBAHAN.'
        )

        return
    end

    batasKmh[0] = tahan(
        batasKmh[0],
        50,
        500
    )

    aksel[0] = tahan(
        aksel[0],
        100,
        1000
    )

    rem[0] = tahan(
        rem[0],
        100,
        600
    )

    jeda[0] = tahan(
        jeda[0],
        130,
        700
    )

    idAktif = data.id
    modelAktif = data.model

    terakhirTulis = waktu()
    jumlahTulis = 0

    bantuan = true

    info(
        'BANTUAN AKTIF. ' ..
        'GAS DAN REM DIPANTAU LIVE.'
    )
end

-- =====================================
-- PERUBAHAN LAJU REAL-TIME
-- =====================================

local function perbaruiBantuan()

    if not bantuan then
        return
    end

    local data, masalah = kendaraan()

    if not data then

        matikan(
            'BANTUAN MATI: ' ..
            masalah
        )

        return
    end

    -- Kalau kendaraan berubah,
    -- bantuan kendaraan lama dimatikan.
    if data.id ~= idAktif
        or data.model ~= modelAktif then

        matikan(
            'KENDARAAN BERGANTI. ' ..
            'BANTUAN DIMATIKAN.'
        )

        return
    end

    local sekarang = waktu()

    if sekarang - terakhirTulis
        < jeda[0] then

        return
    end

    terakhirTulis = sekarang

    local laju = data.speed

    -- Biarkan kendaraan mulai bergerak
    -- memakai mesin bawaan.
    if laju < 1.7 then
        return
    end

    -- Kalau gas dan rem sama-sama
    -- aktif atau sama-sama lepas,
    -- jangan melakukan perubahan.
    if gas == remDitekan then
        return
    end

    local tujuan = nil
    local jenis = nil

    -- =================================
    -- AKSELERASI TAMBAHAN
    -- =================================

    if gas and aksel[0] > 100 then

        -- Batas untuk dorongan bantuan.
        -- BUKAN pembatas fisika bawaan.
        local plafon =
            batasKmh[0] / 3.6

        -- Kalau sudah melewati plafon,
        -- cukup hentikan bantuan.
        -- Jangan memperlambat kendaraan.
        if laju >= plafon then
            return
        end

        local kuat =
            (aksel[0] - 100) / 900

        local dorong =
            0.16 + 2.34 * kuat

        tujuan = math.min(
            plafon,
            laju + dorong
        )

        jenis = 'AKSELERASI'

    -- =================================
    -- KEKUATAN REM TAMBAHAN
    -- =================================

    elseif remDitekan
        and rem[0] > 100 then

        local kuat =
            (rem[0] - 100) / 500

        local pengereman =
            0.16 + 2.34 * kuat

        tujuan = math.max(
            0,
            laju - pengereman
        )

        jenis = 'REM'
    end

    -- =================================
    -- JANGAN MENULIS KECEPATAN
    -- KALAU TIDAK ADA PERUBAHAN
    -- =================================

    if not tujuan
        or math.abs(tujuan - laju)
            < 0.02 then

        return
    end

    -- =================================
    -- CATAT PEMANGGILAN NATIVE
    -- =================================

    if jumlahTulis == 0 then

        catat(
            'SEBELUM PERINTAH ' ..
            'KECEPATAN PERTAMA: ' ..
            jenis
        )
    end

    -- Fungsi ini sudah berhasil
    -- dipanggil pada tes ReSA V1.4.
    local berhasil, gagal = pcall(
        setCarForwardSpeed,
        data.id,
        tujuan
    )

    if not berhasil then

        matikan(
            'GAGAL MENGUBAH LAJU: ' ..
            tostring(gagal)
        )

        return
    end

    jumlahTulis = jumlahTulis + 1

    -- Supaya alloader.log tidak penuh,
    -- catat perubahan pertama dan
    -- setiap 15 perubahan berikutnya.
    if jumlahTulis == 1
        or jumlahTulis % 15 == 0 then

        catat(string.format(
            '%s #%d: %.2f -> %.2f',
            jenis,
            jumlahTulis,
            laju,
            tujuan
        ))
    end
end

