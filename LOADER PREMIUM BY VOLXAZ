-- =====================================
-- CATATAN HANYA KE alloader.log
-- =====================================

local function catat(s)
    print(
        '[VOLXAZ V2] ' .. tostring(s)
    )
end

local function info(s)
    pesan = tostring(s)
    catat(pesan)

    if type(isSampAvailable) == 'function'
        and isSampAvailable()
        and type(sampAddChatMessage)
            == 'function' then

        sampAddChatMessage(
            '[VOLXAZ] ' .. pesan,
            0xAA55FF
        )
    end
end

local function valid(n)
    return type(n) == 'number'
        and n == n
        and n ~= math.huge
        and n ~= -math.huge
end

local function tahan(n, a, b)
    return math.max(
        a,
        math.min(b, n)
    )
end

local function waktu()
    if type(getGameTimer) == 'function' then

        local ok, hasil =
            pcall(getGameTimer)

        if ok and valid(hasil) then
            return hasil
        end
    end

    return math.floor(
        os.clock() * 1000
    )
end

-- =====================================
-- BACA KENDARAAN
-- MENGGUNAKAN METODE LOLOS TES V1.4
-- =====================================

local function kendaraan()

    if not PLAYER_PED
        or PLAYER_PED == 0 then

        return nil,
            'KARAKTER BELUM SIAP'
    end

    if type(isCharInAnyCar)
        ~= 'function'
        or type(getCarCharIsUsing)
            ~= 'function'
        or type(getCarModel)
            ~= 'function'
        or type(getCarSpeed)
            ~= 'function' then

        return nil,
            'API KENDARAAN TIDAK TERSEDIA'
    end

    local ok, diDalam = pcall(
        isCharInAnyCar,
        PLAYER_PED
    )

    if not ok or diDalam ~= true then

        return nil,
            'SEDANG TIDAK NAIK KENDARAAN'
    end

    -- Jangan menggunakan
    -- storeCarCharIsIn yang dulu -1.

    local okId, id = pcall(
        getCarCharIsUsing,
        PLAYER_PED
    )

    if not okId
        or not valid(id)
        or id <= 0 then

        return nil,
            'ID KENDARAAN TIDAK VALID'
    end

    local okModel, model = pcall(
        getCarModel,
        id
    )

    if not okModel
        or not valid(model)
        or model < 400
        or model > 611 then

        return nil,
            'MODEL KENDARAAN TIDAK VALID'
    end

    local okSpeed, speed = pcall(
        getCarSpeed,
        id
    )

    if not okSpeed
        or not valid(speed)
        or speed < 0
        or speed > 220 then

        return nil,
            'KECEPATAN TIDAK VALID'
    end

    idTeks = tostring(id)
    modelTeks = tostring(model)

    speedTeks = string.format(
        '%.2f',
        speed
    )

    return {
        id = id,
        model = model,
        speed = speed
    }
end

