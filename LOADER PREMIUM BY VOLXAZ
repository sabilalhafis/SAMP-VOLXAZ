-- =====================================
-- SISTEM UTAMA
-- =====================================

function main()

    while not isSampAvailable() do
        wait(300)
    end

    info(
        'V2 SIAP. LOG HANYA KE alloader.log.'
    )

    -- Perintah chat untuk membuka
    -- atau menutup menu.
    if type(sampRegisterChatCommand)
        == 'function' then

        sampRegisterChatCommand(
            'vhandling',
            function()
                menu[0] = not menu[0]
            end
        )
    end

    while true do

        wait(60)

        local perintah = permintaan
        permintaan = nil

        -- =================================
        -- PROSES TOMBOL GUI
        -- =================================

        if perintah == 'reset' then

            reset()

        elseif perintah == 'pantau' then

            pantau = not pantau

            if not pantau then

                matikan(nil)

                gas = false
                remDitekan = false

                gasDulu = false
                remDulu = false
            end

            info(
                pantau
                and (
                    'PANTAU INPUT AKTIF. ' ..
                    'GAS DAN REM BOLEH BERGANTIAN.'
                )
                or (
                    'PANTAU MATI. ' ..
                    'BANTUAN JUGA DIMATIKAN.'
                )
            )

        elseif perintah == 'sumber' then

            matikan(nil)

            sumber =
                sumber % #namaSumber + 1

            gasDulu = false
            remDulu = false

            pernahGas = false
            pernahRem = false

            info(
                'SUMBER INPUT: ' ..
                namaSumber[sumber] ..
                '. UJI GAS DAN REM LAGI.'
            )

        elseif perintah == 'santai' then

            preset(1)

        elseif perintah == 'kencang' then

            preset(2)

        elseif perintah == 'brutal' then

            preset(3)

        elseif perintah == 'terapkan' then

            terapkan()
        end

        -- =================================
        -- PEMANTAUAN INPUT TERUS-MENERUS
        -- =================================

        if pantau then

            local t = waktu()

            if t - terakhirBaca >= 60 then

                terakhirBaca = t

                local data = kendaraan()

                if not data then

                    if bantuan then
                        matikan(
                            'KELUAR KENDARAAN: ' ..
                            'BANTUAN DIMATIKAN'
                        )
                    end

                    gas = false
                    remDitekan = false

                    gasDulu = false
                    remDulu = false

                else
                    bacaInput()
                end
            end
        end

        -- =================================
        -- BANTUAN KECEPATAN REAL-TIME
        -- =================================

        if bantuan then
            perbaruiBantuan()
        end
    end
end
